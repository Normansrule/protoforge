{
  "meta": {
    "id": "iris",
    "name": "Iris Smart Glasses",
    "codename": "IRIS",
    "version": "0.4.0",
    "tagline": "Open-source monocular heads-up display glasses, built from scratch",
    "description": "Iris is a reference product for Protoforge: lightweight glasses with a 640x400 micro-OLED heads-up display in the right eye, two-microphone voice capture, head tracking, a capacitive touch strip and a Bluetooth Low Energy (BLE) link to a phone. Every number in this file feeds a simulation somewhere in the workbench.",
    "author": "Aleksander Norman"
  },
  "concept": {
    "problem": "Glancing at a phone for directions, captions, notes or notifications pulls attention away from the world. Existing smart glasses are closed, expensive and impossible to learn from.",
    "vision": "An all-day, sub-50 g pair of glasses that shows small, glanceable information in the corner of your vision, hears your voice clearly, and whose every design decision - circuit, optic, chip, frame and factory - is open and reproducible.",
    "users": ["Students and makers learning hardware", "Commuters wanting heads-up navigation", "People who benefit from live captions", "Engineers prototyping wearable ideas"],
    "use_cases": [
      { "id": "UC-1", "title": "Turn-by-turn walking directions", "narrative": "The phone streams the next maneuver over BLE; Iris shows an arrow and distance, redrawing only when it changes." },
      { "id": "UC-2", "title": "Live captions", "narrative": "Iris captures speech with its two-microphone beamformer, streams audio to the phone for transcription and shows the returned captions." },
      { "id": "UC-3", "title": "Glanceable notifications", "narrative": "A tap on the temple wakes the display, a swipe dismisses; head-tilt gestures scroll." },
      { "id": "UC-4", "title": "Teleprompter / speaker notes", "narrative": "Notes scroll at a pace set by head nods or taps during a presentation." }
    ],
    "constraints": [
      "Total mass at most 50 g, balanced between left and right temples",
      "Must look like ordinary glasses from 2 m away",
      "Hobbyist-buildable prototype: 3D-printed frame, 2-layer PCB, off-the-shelf modules",
      "Path to volume: injection-molded frame, turnkey PCB assembly"
    ]
  },
  "needs": [
    { "id": "N-1", "text": "Wear it all day without noticing the weight", "stakeholder": "User", "priority": 1 },
    { "id": "N-2", "text": "Last a full working day on one charge", "stakeholder": "User", "priority": 1 },
    { "id": "N-3", "text": "Read text in the display comfortably at a glance", "stakeholder": "User", "priority": 1 },
    { "id": "N-4", "text": "Be understood by voice in a noisy street", "stakeholder": "User", "priority": 2 },
    { "id": "N-5", "text": "Never feel hot against the skin", "stakeholder": "User / Safety", "priority": 1 },
    { "id": "N-6", "text": "Content stays stable when the head moves", "stakeholder": "User", "priority": 2 },
    { "id": "N-7", "text": "Can be built by one engineer, then manufactured in volume", "stakeholder": "Maker / Business", "priority": 1 },
    { "id": "N-8", "text": "Retail price accessible to students", "stakeholder": "Business", "priority": 2 }
  ],
  "requirements": [
    { "id": "R-001", "text": "Total wearable mass shall be at most 50 g.", "rationale": "Mainstream smart glasses land near 50 g; ordinary frames are 20-35 g.", "kind": "performance", "derives_from": ["N-1"], "allocated_to": ["SYS-FRM", "SYS-PWR", "SYS-OPT"], "verification": { "method": "analysis", "metric": "mass.total_g", "cmp": "le", "target": 50, "unit": "g" } },
    { "id": "R-002", "text": "Battery life in the reference mixed-use profile shall be at least 8 h.", "rationale": "A working day with the display used about a third of the time.", "kind": "performance", "derives_from": ["N-2"], "allocated_to": ["SYS-PWR", "SYS-SW"], "verification": { "method": "analysis", "metric": "power.battery_life_h", "cmp": "ge", "target": 8, "unit": "h" } },
    { "id": "R-003", "text": "Average system power in the reference profile shall be at most 80 mW.", "rationale": "Derived from R-002 with a 180 mAh cell and margin.", "kind": "performance", "derives_from": ["N-2"], "allocated_to": ["SYS-PWR", "SYS-CMP", "SYS-OPT"], "verification": { "method": "analysis", "metric": "power.avg_power_mw", "cmp": "le", "target": 80, "unit": "mW" } },
    { "id": "R-004", "text": "Horizontal field of view of the virtual display shall be at least 20 degrees.", "rationale": "Enough for two lines of 20 characters.", "kind": "performance", "derives_from": ["N-3"], "allocated_to": ["SYS-OPT"], "verification": { "method": "analysis", "metric": "optics.hfov_deg", "cmp": "ge", "target": 20, "unit": "deg" } },
    { "id": "R-005", "text": "Angular resolution shall be at least 25 pixels per degree.", "rationale": "Small text stays legible; 60 ppd is roughly retinal.", "kind": "performance", "derives_from": ["N-3"], "allocated_to": ["SYS-OPT"], "verification": { "method": "analysis", "metric": "optics.ppd", "cmp": "ge", "target": 25, "unit": "px/deg" } },
    { "id": "R-006", "text": "The virtual image shall appear between 1 m and 3 m from the eye.", "rationale": "Reduces refocusing between the display and the world.", "kind": "performance", "derives_from": ["N-3"], "allocated_to": ["SYS-OPT"], "verification": { "method": "analysis", "metric": "optics.virtual_image_m", "cmp": "between", "target": 1, "target_hi": 3, "unit": "m" } },
    { "id": "R-007", "text": "The eyebox shall be at least 5 mm wide.", "rationale": "Tolerates frame slip and different faces without losing the image.", "kind": "performance", "derives_from": ["N-3"], "allocated_to": ["SYS-OPT", "SYS-FRM"], "verification": { "method": "analysis", "metric": "optics.eyebox_mm", "cmp": "ge", "target": 5, "unit": "mm" } },
    { "id": "R-008", "text": "Skin-contact surfaces shall stay at or below 41 C at 30 C ambient with the display on continuously.", "rationale": "Conservative margin under common 43 C limits for prolonged skin contact.", "kind": "safety", "derives_from": ["N-5"], "allocated_to": ["SYS-PWR", "SYS-FRM"], "verification": { "method": "analysis", "metric": "thermal.max_skin_c", "cmp": "le", "target": 41, "unit": "C" } },
    { "id": "R-009", "text": "Microphone array directivity index at 1 kHz shall be at least 4 dB.", "rationale": "Rejects diffuse street noise relative to the wearer's voice.", "kind": "performance", "derives_from": ["N-4"], "allocated_to": ["SYS-AUD"], "verification": { "method": "analysis", "metric": "dsp.mic_di_db", "cmp": "ge", "target": 4, "unit": "dB" } },
    { "id": "R-010", "text": "PDM decimation filter stopband attenuation shall be at least 60 dB.", "rationale": "Keeps aliased ultrasonic noise below the microphone noise floor.", "kind": "performance", "derives_from": ["N-4"], "allocated_to": ["SYS-AUD", "SYS-ASIC"], "verification": { "method": "analysis", "metric": "dsp.decim_stopband_db", "cmp": "ge", "target": 60, "unit": "dB" } },
    { "id": "R-011", "text": "Head-orientation estimate error shall be at most 2 degrees RMS during normal head motion.", "rationale": "Head-locked or world-locked content must not visibly swim.", "kind": "performance", "derives_from": ["N-6"], "allocated_to": ["SYS-SNS"], "verification": { "method": "analysis", "metric": "control.head_rms_err_deg", "cmp": "le", "target": 2, "unit": "deg" } },
    { "id": "R-012", "text": "The 1.8 V rail shall droop by at most 50 mV on a display turn-on load step.", "rationale": "Protects the BLE SoC brown-out threshold.", "kind": "performance", "derives_from": ["N-2"], "allocated_to": ["SYS-PWR", "SYS-PCB"], "verification": { "method": "analysis", "metric": "circuit.rail_droop_mv", "cmp": "le", "target": 50, "unit": "mV" } },
    { "id": "R-013", "text": "Buck converter output ripple shall be at most 30 mV peak-to-peak.", "rationale": "Keeps the radio and IMU noise floor clean.", "kind": "performance", "derives_from": ["N-2"], "allocated_to": ["SYS-PWR"], "verification": { "method": "analysis", "metric": "circuit.buck_ripple_mv", "cmp": "le", "target": 30, "unit": "mV" } },
    { "id": "R-014", "text": "Battery-sense divider current shall be at most 2 uA.", "rationale": "An always-on divider must not drain the cell in storage.", "kind": "performance", "derives_from": ["N-2"], "allocated_to": ["SYS-PWR"], "verification": { "method": "analysis", "metric": "circuit.vbat_divider_ua", "cmp": "le", "target": 2, "unit": "uA" } },
    { "id": "R-015", "text": "The IRIS-DSP co-processor shall close timing at 50 MHz (critical path at most 20 ns).", "rationale": "Fixed by the PDM clock plan.", "kind": "performance", "derives_from": ["N-4"], "allocated_to": ["SYS-ASIC"], "verification": { "method": "analysis", "metric": "chip.critical_path_ns", "cmp": "le", "target": 20, "unit": "ns" } },
    { "id": "R-016", "text": "The IRIS-DSP co-processor shall fit in a 3000 standard-cell budget.", "rationale": "Small enough for a shared-shuttle or FPGA prototype.", "kind": "manufacturing", "derives_from": ["N-7"], "allocated_to": ["SYS-ASIC"], "verification": { "method": "analysis", "metric": "chip.est_cells", "cmp": "le", "target": 3000, "unit": "cells" } },
    { "id": "R-017", "text": "All PCB nets shall be routed with zero design-rule violations.", "rationale": "Board is ready to send to a fab.", "kind": "manufacturing", "derives_from": ["N-7"], "allocated_to": ["SYS-PCB"], "verification": { "method": "analysis", "metric": "pcb.routed_pct", "cmp": "ge", "target": 100, "unit": "%" } },
    { "id": "R-018", "text": "Design-rule check shall report zero violations.", "rationale": "Clearance and width rules match the fab's standard capability.", "kind": "manufacturing", "derives_from": ["N-7"], "allocated_to": ["SYS-PCB"], "verification": { "method": "analysis", "metric": "pcb.drc_violations", "cmp": "le", "target": 0, "unit": "count" } },
    { "id": "R-019", "text": "The PCB shall fit inside the right-temple pod with at least 1 mm margin.", "rationale": "Mechanical-electrical interface.", "kind": "interface", "derives_from": ["N-1", "N-7"], "allocated_to": ["SYS-PCB", "SYS-FRM"], "verification": { "method": "analysis", "metric": "fit.pcb_pod_margin_mm", "cmp": "ge", "target": 1, "unit": "mm" } },
    { "id": "R-020", "text": "Molded frame walls shall have at least 1 degree of draft.", "rationale": "Allows clean ejection from the mold.", "kind": "manufacturing", "derives_from": ["N-7"], "allocated_to": ["SYS-FRM", "SYS-MFG"], "verification": { "method": "analysis", "metric": "molding.min_draft_deg", "cmp": "ge", "target": 1, "unit": "deg" } },
    { "id": "R-021", "text": "A full prototype frame set shall print in at most 8 h on a hobby FDM printer.", "rationale": "One overnight print per design iteration.", "kind": "manufacturing", "derives_from": ["N-7"], "allocated_to": ["SYS-FRM"], "verification": { "method": "analysis", "metric": "print.total_time_h", "cmp": "le", "target": 8, "unit": "h" } },
    { "id": "R-022", "text": "Unit cost at 1,000 units shall be at most 120 USD.", "rationale": "Supports a student-accessible retail price.", "kind": "cost", "derives_from": ["N-8"], "allocated_to": ["SYS-MFG"], "verification": { "method": "analysis", "metric": "mfg.unit_cost_usd", "cmp": "le", "target": 120, "unit": "USD" } },
    { "id": "R-023", "text": "Automated pick-and-place of the main board shall take at most 60 s per board.", "rationale": "Keeps assembly cost low at volume.", "kind": "manufacturing", "derives_from": ["N-7", "N-8"], "allocated_to": ["SYS-MFG"], "verification": { "method": "analysis", "metric": "robotics.pnp_cycle_s", "cmp": "le", "target": 60, "unit": "s" } },
    { "id": "R-024", "text": "A learned power policy should extend battery life by at least 5 % over the fixed policy.", "rationale": "Stretch goal: adaptive display/radio duty cycling.", "kind": "goal", "derives_from": ["N-2"], "allocated_to": ["SYS-SW"], "verification": { "method": "analysis", "metric": "rl.policy_life_gain_pct", "cmp": "ge", "target": 5, "unit": "%" } }
  ],
  "subsystems": [
    { "id": "SYS-OPT", "name": "Display & optics", "domain": "optical", "lab": "optics", "description": "Micro-OLED, collimating lens and a 45 degree partially-reflective combiner in the right lens.", "functions": ["Form virtual image", "Combine display with world view"] },
    { "id": "SYS-PWR", "name": "Power", "domain": "electrical", "lab": "power", "description": "LiPo cell in the left temple, USB-C charging, high-efficiency buck to 1.8 V, battery sensing.", "functions": ["Store energy", "Charge", "Regulate rails", "Report state of charge"] },
    { "id": "SYS-CMP", "name": "Compute & radio", "domain": "electrical", "lab": "circuit", "description": "BLE system-on-chip running firmware, talking to the phone app.", "functions": ["Run firmware", "BLE link", "Drive display"] },
    { "id": "SYS-AUD", "name": "Voice capture", "domain": "acoustic", "lab": "dsp", "description": "Two PDM MEMS microphones in an endfire pair along the right temple with a differential beamformer.", "functions": ["Capture speech", "Suppress noise"] },
    { "id": "SYS-SNS", "name": "Sensing & head tracking", "domain": "software", "lab": "control", "description": "6-axis IMU fused with a complementary filter; capacitive touch strip on the temple.", "functions": ["Estimate head orientation", "Detect gestures"] },
    { "id": "SYS-ASIC", "name": "IRIS-DSP co-processor", "domain": "silicon", "lab": "chip", "description": "Optional custom digital block: PDM decimation FIR and touch-gesture state machine, prototyped on FPGA, taped out on a shared shuttle.", "functions": ["Decimate PDM audio", "Recognise gestures"] },
    { "id": "SYS-PCB", "name": "Main PCB", "domain": "electrical", "lab": "pcb", "description": "58 x 10 mm 2-layer board in the right-temple pod.", "functions": ["Interconnect electronics"] },
    { "id": "SYS-FRM", "name": "Frame & enclosures", "domain": "mechanical", "lab": "cad", "description": "Parametric front, temples and pods; 3D-printed for prototypes, injection-molded for volume.", "functions": ["Hold lenses and optics", "House electronics", "Fit the face"] },
    { "id": "SYS-SW", "name": "Firmware & power policy", "domain": "software", "lab": "rl", "description": "Display/radio scheduling, learned power policy, gesture handling.", "functions": ["Schedule power states", "Handle UI events"] },
    { "id": "SYS-MFG", "name": "Manufacturing & assembly", "domain": "manufacturing", "lab": "mfg", "description": "PCB assembly service, molded frame, final assembly and test.", "functions": ["Source parts", "Assemble", "Test"] }
  ],
  "interfaces": [
    { "id": "IF-01", "from": "SYS-CMP", "to": "SYS-OPT", "kind": "SPI", "description": "Display command/pixel link over a 24-pin FPC through the hinge." },
    { "id": "IF-02", "from": "SYS-AUD", "to": "SYS-CMP", "kind": "PDM", "description": "Two microphones share a PDM clock, left/right on one data line." },
    { "id": "IF-03", "from": "SYS-SNS", "to": "SYS-CMP", "kind": "I2C", "description": "IMU and touch controller on a 400 kHz I2C bus." },
    { "id": "IF-04", "from": "SYS-PWR", "to": "SYS-CMP", "kind": "POWER", "description": "1.8 V core rail from the buck; VBAT sense to an ADC pin." },
    { "id": "IF-05", "from": "SYS-PWR", "to": "SYS-OPT", "kind": "POWER", "description": "3.3 V display rail enabled by a GPIO load switch." },
    { "id": "IF-06", "from": "SYS-CMP", "to": "SYS-SW", "kind": "BLE", "description": "Phone app link (GATT service)." },
    { "id": "IF-07", "from": "SYS-PCB", "to": "SYS-FRM", "kind": "MECH", "description": "Board slides into pod rails; USB-C aligned to rear opening." },
    { "id": "IF-08", "from": "SYS-OPT", "to": "SYS-FRM", "kind": "MECH", "description": "Optics module screws to the right rim; combiner sits in front of the right lens." },
    { "id": "IF-09", "from": "SYS-PWR", "to": "SYS-FRM", "kind": "THERMAL", "description": "Heat from the pod spreads into the temple shell and the air." },
    { "id": "IF-10", "from": "SYS-ASIC", "to": "SYS-CMP", "kind": "SPI", "description": "Co-processor streams 16 kHz PCM frames and gesture events." }
  ],
