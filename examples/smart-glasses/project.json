    { "refdes": "MK2", "name": "PDM MEMS microphone (rear)", "part_class": "Bottom-port digital MEMS mic", "example_part": "PDM MEMS mic, 64 dB SNR class", "subsystem": "SYS-AUD", "qty": 1, "unit_cost_usd": 0.8, "mass_g": 0.02, "power": { "active_mw": 0.9, "sleep_mw": 0.02, "duty": 0.25 }, "footprint": "MIC_LGA_3.5x2.65", "on_pcb": true, "location": "right_pod" },
