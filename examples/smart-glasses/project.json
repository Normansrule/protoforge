    { "refdes": "C4", "name": "IMU decoupling 100 nF", "part_class": "X7R MLCC", "example_part": "100 nF 0402", "subsystem": "SYS-SNS", "qty": 1, "unit_cost_usd": 0.01, "mass_g": 0.002, "footprint": "0402", "on_pcb": true, "location": "right_pod" },
    { "refdes": "C5", "name": "Charger cap 1 uF", "part_class": "X5R MLCC", "example_part": "1 uF 0402", "subsystem": "SYS-PWR", "qty": 1, "unit_cost_usd": 0.01, "mass_g": 0.002, "footprint": "0402", "on_pcb": true, "location": "right_pod" },
    { "refdes": "C6", "name": "Sense filter cap 100 nF", "part_class": "X7R MLCC", "example_part": "100 nF 0402", "subsystem": "SYS-PWR", "qty": 1, "unit_cost_usd": 0.01, "mass_g": 0.002, "footprint": "0402", "on_pcb": true, "location": "right_pod" },
    { "refdes": "R1", "name": "VBAT divider top 1.5 M", "part_class": "Thick film 1 %", "example_part": "1.5 M 0402", "subsystem": "SYS-PWR", "qty": 1, "unit_cost_usd": 0.005, "mass_g": 0.001, "footprint": "0402", "on_pcb": true, "location": "right_pod" },
    { "refdes": "R2", "name": "VBAT divider bottom 1 M", "part_class": "Thick film 1 %", "example_part": "1 M 0402", "subsystem": "SYS-PWR", "qty": 1, "unit_cost_usd": 0.005, "mass_g": 0.001, "footprint": "0402", "on_pcb": true, "location": "right_pod" },
